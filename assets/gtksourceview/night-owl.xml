<?xml version="1.0" encoding="UTF-8"?>
<!--

  Night Owl color scheme for GtkSourceView (Mousepad, gedit, …).
  Ported from Sarah Drasner's Night Owl VS Code theme
  (https://github.com/sdras/night-owl-vscode-theme) for the Debian dev box.
  Pairs with the Tilix Night Owl palette (assets/tilix.dconf) and the Kate
  Night Owl theme so the terminal and both editors match.

-->
<style-scheme id="night-owl" _name="Night Owl" version="1.0">
  <author>Sarah Drasner (palette); Debian dev box (GtkSourceView port)</author>
  <_description>Dark navy theme ported from the Night Owl VS Code theme</_description>

  <metadata>
    <property name="variant">dark</property>
  </metadata>

  <!-- Night Owl Palette -->
  <color name="navy"        value="#011627"/>
  <color name="navy-line"   value="#01253D"/>
  <color name="navy-sel"    value="#1D3B53"/>
  <color name="fg"          value="#D6DEEB"/>
  <color name="gutter"      value="#4B6479"/>
  <color name="gutter-hi"   value="#C5E4FD"/>
  <color name="comment"     value="#637777"/>
  <color name="purple"      value="#C792EA"/>
  <color name="blue"        value="#82AAFF"/>
  <color name="teal"        value="#7FDBCA"/>
  <color name="green"       value="#22DA6E"/>
  <color name="lime"        value="#ADDB67"/>
  <color name="cyan"        value="#21C7A8"/>
  <color name="orange"      value="#F78C6C"/>
  <color name="sand"        value="#ECC48D"/>
  <color name="yellow"      value="#FFCB8B"/>
  <color name="lemon"       value="#FFEB95"/>
  <color name="red"         value="#EF5350"/>
  <color name="pink"        value="#FF5874"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="fg"        background="navy"/>
  <style name="selection"                   background="navy-sel"/>
  <style name="cursor"                      foreground="fg"/>
  <style name="secondary-cursor"            foreground="gutter"/>
  <style name="current-line"                background="navy-line"/>
  <style name="current-line-number"         foreground="gutter-hi" background="navy-line"/>
  <style name="line-numbers"                foreground="gutter"    background="navy"/>
  <style name="draw-spaces"                 foreground="gutter"/>
  <style name="background-pattern"          background="navy-line"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="navy"      background="teal"   bold="true"/>
  <style name="bracket-mismatch"            foreground="fg"        background="red"/>

  <!-- Right Margin -->
  <style name="right-margin"                foreground="navy-sel"  background="navy-sel"/>

  <!-- Search Matching -->
  <style name="search-match"                foreground="navy"      background="lemon"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="comment"   italic="true"/>
  <style name="def:shebang"                 foreground="comment"   bold="true"/>
  <style name="def:doc-comment-element"     foreground="comment"   italic="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="orange"/>
  <style name="def:string"                  foreground="sand"/>
  <style name="def:special-char"            foreground="cyan"/>
  <style name="def:character"               foreground="sand"/>
  <style name="def:number"                  foreground="orange"/>
  <style name="def:decimal"                 foreground="orange"/>
  <style name="def:base-n-integer"          foreground="orange"/>
  <style name="def:floating-point"          foreground="orange"/>
  <style name="def:boolean"                 foreground="pink"/>
  <style name="def:special-constant"        foreground="pink"/>

  <!-- Identifiers / Functions -->
  <style name="def:identifier"              foreground="fg"/>
  <style name="def:function"                foreground="blue"/>
  <style name="def:builtin"                 foreground="blue"/>

  <!-- Keywords / Statements / Types -->
  <style name="def:keyword"                 foreground="purple"/>
  <style name="def:statement"               foreground="purple"   italic="true"/>
  <style name="def:type"                    foreground="yellow"/>
  <style name="def:operator"                foreground="purple"/>
  <style name="def:preprocessor"            foreground="lime"/>
  <style name="def:reserved"                foreground="purple"/>

  <!-- Markup (Markdown, etc.) -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         foreground="orange"   bold="true"/>
  <style name="def:inline-code"             foreground="teal"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="pink"/>
  <style name="def:link-symbol"             foreground="pink"     bold="true"/>
  <style name="def:link-destination"        foreground="sand"     italic="true" underline="single"/>
  <style name="def:heading"                 foreground="blue"     bold="true"/>
  <style name="def:thematic-break"          foreground="purple"/>
  <style name="def:preformatted-section"    foreground="teal"/>
  <style name="def:list-marker"             foreground="cyan"/>

  <!-- Diff -->
  <style name="diff:added-line"             foreground="green"/>
  <style name="diff:removed-line"           foreground="red"/>
  <style name="diff:changed-line"           foreground="yellow"/>
  <style name="diff:location"               foreground="blue"/>
  <style name="diff:diff-file"              foreground="yellow"  bold="true"/>

  <!-- Others -->
  <style name="def:error"                   underline="error"    underline-color="red"/>
  <style name="def:warning"                 underline="error"    underline-color="lemon"/>
  <style name="def:note"                    foreground="lemon"   bold="true"/>
  <style name="def:net-address"             foreground="sand"    italic="true" underline="single"/>
</style-scheme>
