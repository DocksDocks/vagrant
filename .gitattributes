# This repository is consumed by a Linux guest VM: Vagrant provisioning runs the
# shell scripts and reads the assets from the synced folder (/vagrant). Since the
# Vagrantfile now prefers the cloned on-disk copy (plans/0011), the working-tree
# line endings reach the guest verbatim.
#
# Force LF in the working tree on EVERY host — including Windows checkouts where
# Git defaults to core.autocrlf=true — so nothing reaches the guest with CRLF.
# CRLF would make `bash` abort immediately (`set: pipefail: invalid option
# name`, `$'\r': command not found`), break sourced helpers like _lib.sh, and
# corrupt systemd unit / .desktop / dconf / XML parsing.
* text=auto eol=lf

# Explicit LF for everything the guest executes or parses — defensive in case
# `text=auto` ever misdetects one of these as binary.
*.sh        text eol=lf
Vagrantfile text eol=lf
*.rb        text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.conf      text eol=lf
*.list      text eol=lf
*.rc        text eol=lf
*.css       text eol=lf
*.desktop   text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.dconf     text eol=lf
*.md        text eol=lf
*.hcl       text eol=lf

# Extension-less helpers under assets/bin and the apt drop-in are shell/config —
# pin them explicitly since globbing "no extension" isn't reliable.
assets/bin/git-pull-all      text eol=lf
assets/bin/screenshot-region text eol=lf
assets/apt/99force-conf      text eol=lf

# True binaries — never normalize (none committed today; future-proofing).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.gz   binary
*.xz   binary
*.zip  binary
*.iso  binary
*.ttf  binary
*.otf  binary
